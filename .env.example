# Frontend settings (Vite reads VITE_* at build and dev time). Copy to .env
# and change what you need. Never a secret here: everything VITE_* ends up
# in the browser.

# Base of the API calls (src/services/apiClient.ts). /api is proxied by Vite
# to the backend in development (vite.config.ts) and by nginx in production.
VITE_API_BASE=/api
