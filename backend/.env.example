# Backend settings: every variable that backend/app/core/config.py reads,
# with its default value and what it is for. Copy to backend/.env and change
# what you need; a variable left out of backend/.env takes the default shown
# here. Never commit the real .env (it has passwords).
# tests/unit/test_env_example.py fails if this file and config.py differ.

# --- Environment ---
# "development" or "production".
ENVIRONMENT=development
# Level of the JSON log on stderr: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Database ---
# Always postgresql+asyncpg://. The default is the development database.
DATABASE_URL=postgresql+asyncpg://aal:aal@localhost:5432/aal
# The tests' own database (read by backend/tests and the npm test scripts,
# never by the app): its name must end in _test and differ from
# DATABASE_URL. `npm run test:db:create` creates it and adds this line to
# backend/.env. Never on a server.
# TEST_DATABASE_URL=postgresql+asyncpg://aal:aal@localhost:5432/aal_test

# --- Sessions ---
# RS256 key pair that signs the access tokens, relative to backend/
# (python scripts/generate_rsa_keypair.py writes it; keys/ is not in git).
# Token lifetimes, password policy and login limits are parameters, shown
# in Settings -> Parámetros (app/services/parameters.py), not variables.
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
# "iss" and "aud" of the access tokens (the IdP's, once the corporate SSO
# is connected).
JWT_ISSUER=aal
JWT_AUDIENCE=aal-api
# Secure flag of the refresh cookie. Browsers accept it on
# http://localhost, so leave it on unless a plain-HTTP host that is not
# localhost serves the app.
REFRESH_COOKIE_SECURE=true

# --- CORS ---
# JSON list of the addresses the browser uses -- never "*" (refused).
CORS_ORIGINS=["http://localhost:5173"]

# --- AACF ---
# The framework copy's VERSION file (GET /api/version); relative to backend/.
AACF_VERSION_FILE=../aacf/VERSION
